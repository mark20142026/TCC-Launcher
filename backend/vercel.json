{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/oneclient/CHANGE_LOG.md", "destination": "/api/changelog" },
    { "source": "/oneclient/tos.json", "destination": "/api/tos" },
    { "source": "/oneclient/latest.json", "destination": "/api/latest" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/minecraft/v0/manifest.json", "destination": "/api/minecraft" },
    { "source": "/forge/v0/manifest.json", "destination": "/api/forge" },
    { "source": "/fabric/v0/manifest.json", "destination": "/api/fabric" },
    { "source": "/neo/v0/manifest.json", "destination": "/api/neo" },
    { "source": "/quilt/v0/manifest.json", "destination": "/api/quilt" },
    { "source": "/(.*)", "destination": "/api/proxy?path=$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
